ynn_program 1 {
  options {cleanup: false, schedule_masks: false, target_views: false};
  phase "model" {
    value "positive": f32[2, 3];
    value "x": f32[2, 3];
    value "y": f32[2, 3];
    inputs ("x");
    outputs ("y", "positive");
    node relu ("x") -> ("positive") attrs {beta: real(0.0)} scope "Compute";
    node relu6 ("x") -> ("y") attrs {beta: real(0.0)} scope "Compute";
  }
}
