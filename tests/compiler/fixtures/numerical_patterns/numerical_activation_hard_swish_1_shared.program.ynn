ynn_program 1 {
  options {cleanup: false, schedule_masks: false, target_views: false};
  phase "model" {
    value "offset": f32[2, 3];
    value "positive": f32[2, 3];
    const "three": f32[] floats [real(3.0)];
    value "x": f32[2, 3];
    value "y": f32[2, 3];
    inputs ("x");
    outputs ("y", "positive");
    node add ("x", "three") -> ("offset") scope "Compute";
    node relu ("offset") -> ("positive") attrs {beta: real(0.0)} scope "Compute";
    node hard_swish ("x") -> ("y") attrs {beta: real(0.0)} scope "Compute";
  }
}
