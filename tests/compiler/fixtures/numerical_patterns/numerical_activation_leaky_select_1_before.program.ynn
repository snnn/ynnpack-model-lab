ynn_program 1 {
  options {cleanup: false, schedule_masks: false, target_views: false};
  phase "model" {
    const "alpha": f32[] floats [real(0.20000000298023224)];
    value "condition": bool[2, 3];
    value "negative": f32[2, 3];
    value "x": f32[2, 3];
    value "y": f32[2, 3];
    const "zero": f32[] floats [real(0.0)];
    inputs ("x");
    outputs ("y", "negative");
    node greater ("x", "zero") -> ("condition") scope "Compute";
    node mul ("x", "alpha") -> ("negative") scope "Compute";
    node select ("condition", "x", "negative") -> ("y") scope "Compute";
  }
}
