ynn_program 1 {
  options {cleanup: false, schedule_masks: false, target_views: false};
  phase "model" {
    value "negative": f32[2, 3];
    value "positive": f32[2, 3];
    value "scaled": f32[2, 3];
    const "slopes": f32[3] floats [real(0.10000000149011612), real(0.30000001192092896), real(0.699999988079071)];
    value "x": f32[2, 3];
    value "y": f32[2, 3];
    const "zero": f32[] floats [real(0.0)];
    inputs ("x");
    outputs ("y");
    node maximum ("x", "zero") -> ("positive") scope "Compute";
    node minimum ("x", "zero") -> ("negative") scope "Compute";
    node mul ("negative", "slopes") -> ("scaled") scope "Compute";
    node add ("positive", "scaled") -> ("y") scope "Compute";
  }
}
