ynn_program 1 {
  options {cleanup: false, schedule_masks: false, target_views: false};
  phase "model" {
    value "clamp": f32[2, 3];
    value "offset": f32[2, 3];
    value "positive": f32[2, 3];
    value "product": f32[2, 3];
    const "six": f32[] floats [real(6.0)];
    const "three": f32[] floats [real(3.0)];
    value "x": f32[2, 3];
    value "y": f32[2, 3];
    const "zero": f32[] floats [real(0.0)];
    inputs ("x");
    outputs ("y");
    node add ("x", "three") -> ("offset") scope "Compute";
    node maximum ("offset", "zero") -> ("positive") scope "Compute";
    node minimum ("positive", "six") -> ("clamp") scope "Compute";
    node mul ("x", "clamp") -> ("product") scope "Compute";
    node div ("product", "six") -> ("y") scope "Compute";
  }
}
