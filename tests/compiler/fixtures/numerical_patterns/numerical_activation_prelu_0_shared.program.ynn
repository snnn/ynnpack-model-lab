ynn_program 1 {
  options {cleanup: false, schedule_masks: false, target_views: false};
  phase "model" {
    const "slopes": f32[3] floats [real(0.10000000149011612), real(0.30000001192092896), real(0.699999988079071)];
    value "x": f32[2, 3];
    value "y": f32[2, 3];
    inputs ("x");
    outputs ("y");
    node prelu ("x", "slopes") -> ("y") attrs {beta: real(0.0)} scope "Compute";
  }
}
