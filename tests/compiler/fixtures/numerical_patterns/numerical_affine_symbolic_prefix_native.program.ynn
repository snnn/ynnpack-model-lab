ynn_program 1 {
  options {cleanup: false, schedule_masks: false, target_views: false};
  phase "model" {
    symbol {binding: {axis: 0, source: "axis", value: "x"}, id: 1, lower: 0, upper: 8};
    guard {lhs: known(0), mode: "bounds", reason: "symbol 1 lower bound", relation: "le", rhs: symbol(1)};
    guard {lhs: symbol(1), mode: "bounds", reason: "symbol 1 upper bound", relation: "le", rhs: known(8)};
    value "flat": f32[add(0, mul(2, s1)), 3];
    const "scale": f32[3] data {bytes: 12, path: "@parameters/9e25bb84ae6249ebee7f77a1d6126d7b6257c0ff1aecd075482fd112d3208301.bin", sha256: "9e25bb84ae6249ebee7f77a1d6126d7b6257c0ff1aecd075482fd112d3208301"} floats [real(2.0), real(3.0), real(5.0)];
    value "scaled": f32[s1, 2, 3];
    const "w": f32[2, 3] data {bytes: 24, path: "@parameters/259a2e23297810b6704586ca682a0f0497faa0a2260e08a6a30aa79b78fd621b.bin", sha256: "259a2e23297810b6704586ca682a0f0497faa0a2260e08a6a30aa79b78fd621b"} floats [real(0.0), real(0.125), real(0.25), real(0.375), real(0.5), real(0.625)];
    value "x": f32[s1, 2, 3];
    value "y": f32[add(0, mul(2, s1)), 2];
    inputs ("x");
    outputs ("y", "w");
    node mul ("x", "scale") -> ("scaled") attrs {result_dtype: "f32"} scope "Compute";
    node reshape ("scaled") -> ("flat") attrs {result_dtype: "f32", shape: [add([known(0), mul([known(2), symbol(1)])]), known(3)]} scope "Compute";
    node fully_connected ("flat", "w") -> ("y") attrs {result_dtype: "f32"} scope "Compute";
  }
}
