ynn_program 1 {
  options {cleanup: false, schedule_masks: false, target_views: false};
  phase "model" {
    const "coefficient": f32[] floats [real(0.044714998453855515)];
    value "cube": f32[2, 3];
    value "square": f32[2, 3];
    value "term": f32[2, 3];
    value "x": f32[2, 3];
    value "y": f32[2, 3];
    inputs ("x");
    outputs ("y", "term");
    node square ("x") -> ("square") scope "Compute";
    node mul ("x", "square") -> ("cube") scope "Compute";
    node mul ("cube", "coefficient") -> ("term") scope "Compute";
    node gelu ("x") -> ("y") attrs {approximate: true, beta: real(0.0)} scope "Compute";
  }
}
