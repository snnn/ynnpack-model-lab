ynn_program 1 {
  options {cleanup: false, schedule_masks: false, target_views: false};
  phase "model" {
    value "exp": f32[2, 3];
    value "negative": f32[2, 3];
    const "one": f32[] floats [real(1.0)];
    value "x": f32[2, 3];
    value "y": f32[2, 3];
    inputs ("x");
    outputs ("y", "negative");
    node exp ("x") -> ("exp") scope "Compute";
    node sub ("exp", "one") -> ("negative") scope "Compute";
    node elu ("x") -> ("y") attrs {beta: real(0.0)} scope "Compute";
  }
}
