ynn_program 1 {
  phase "model" {
    symbol {binding: {name: "valid", source: "parameter", value: ""}, id: 1, lower: 0, upper: 1};
    guard {lhs: known(0), mode: "bounds", reason: "symbol 1 lower bound", relation: "le", rhs: symbol(1)};
    guard {lhs: symbol(1), mode: "bounds", reason: "symbol 1 upper bound", relation: "le", rhs: known(1)};
    value "history": f32[2, 3, 3];
    value "joined": f32[2, 4, 3];
    value "next": f32[2, 3, 3];
    value "output": f32[2, 1, 1, 3];
    value "spatial": f32[2, 4, 1, 3];
    value "weights": f32[1, 4, 1, 3];
    value "x": f32[2, 1, 3];
    inputs ("x", "history", "weights");
    outputs ("output", "next");
    node concat ("history", "x") -> ("joined") attrs {axis: 1} scope "Compute";
    node slice ("joined") -> ("next") attrs {lengths: [known(2), known(3), known(3)], starts: [known(0), symbol(1), known(0)]} scope "Compute";
    node reshape ("joined") -> ("spatial") attrs {shape: [known(2), known(4), known(1), known(3)]} scope "Compute";
    node depthwise_conv2d ("spatial", "weights") -> ("output") attrs {spatial: {dilations: [1, 1], kernel: [4, 1], multiplier: 1, same: false, strides: [1, 1]}} scope "Compute";
  }
}
