    guard {lhs: symbol(1), mode: "bounds", reason: "symbol 1 upper bound", relation: "le", rhs: known(3)};
    const "b": f32[6] data {bytes: 24, path: "@parameters/5dc3cda8d9d578b20c4c612c7e542522e9cfb6b61c3ed6d03d1d8bbd5dbcfccf.bin", sha256: "5dc3cda8d9d578b20c4c612c7e542522e9cfb6b61c3ed6d03d1d8bbd5dbcfccf"};
