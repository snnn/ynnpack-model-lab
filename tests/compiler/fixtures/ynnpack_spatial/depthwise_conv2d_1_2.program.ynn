ynn_program 1 {
  options {cleanup: false, schedule_masks: false, target_views: false};
  phase "model" {
    symbol {binding: {axis: 0, source: "axis", value: "x"}, id: 1, lower: 1, upper: 3};
    guard {lhs: known(1), mode: "bounds", reason: "symbol 1 lower bound", relation: "le", rhs: symbol(1)};
    guard {lhs: symbol(1), mode: "bounds", reason: "symbol 1 upper bound", relation: "le", rhs: known(3)};
    const "b": f32[6] data {bytes: 24, path: "@parameters/bcf6adab3eaaa21f3622d491fb37dffd25c601ebc2cbcc6f52406fa4c5456ebb.bin", sha256: "bcf6adab3eaaa21f3622d491fb37dffd25c601ebc2cbcc6f52406fa4c5456ebb"};
    const "w": f32[1, 3, 2, 6] data {bytes: 144, path: "@parameters/e9b1c9d9c54108fb0aac4b45049f5b82d19920b7c886bd850a16c65667aaf565.bin", sha256: "e9b1c9d9c54108fb0aac4b45049f5b82d19920b7c886bd850a16c65667aaf565"};
    value "x": f32[s1, 7, 8, 3];
    value "y": f32[s1, 4, 3, 6];
    inputs ("x");
