ynn 1 resource_contract=1 completion_contract=1 profiling=auto {
  weight __ynn_op15_beta: storage<fp32[1]> = asset(a0);
  weight __ynn_op15_one: storage<fp32[1]> = asset(a5);
  weight weight: storage<fp32[8, 8]> = asset(a46);
  let end: index = add(0, (1 * s1), (1 * position));
  dim s1 = axis(q, 2) in 1..=128;
  dim position = parameter("position") in 0..=8448;
  input q: fp32[1, 8, s1, 8];
  input fresh: fp32[1, 2, s1, 8];
  @shape() state kcache: int8[1, 2, 8448, 8];
  @shape() state vcache: int8[1, 2, 8448, 8];
  @shape() state onlycache: int8[1, 2, 8448, 8];
  require committed(kcache) == position;
  require committed(onlycache) == position;
  require committed(vcache) == position;
  @guard(message="symbol 1 lower bound", mode="bounds") require 1 <= s1;
  @guard(message="symbol 1 upper bound", mode="bounds") require s1 <= 128;
  @guard(message="symbol 2 lower bound", mode="bounds") require 0 <= position;
  @guard(message="symbol 2 upper bound", mode="bounds") require position <= 8448;
  @guard(message="append capacity", mode="ordinary") require end <= 8448;
  @guard(message="view reads uninitialized history", mode="ordinary") require end <= end;
  @guard(message="slice bounds", mode="ordinary") require s1 <= s1;
  let knew: int8[1, 2, s1, 8] = quantize(fresh, scale=0.03125, zero=0);
  let vsrc: storage<fp32[1, 2, 0, 8]> = add(fresh, fresh);
  let vnew: int8[1, 2, s1, 8] = quantize(vsrc, scale=0.03125, zero=0);
  let kupdated: storage<int8[1, 2, 8448, 8]> = append(kcache, knew, axis=2, position=position, rows=s1);
  let vupdated: storage<int8[1, 2, 8448, 8]> = append(vcache, vnew, axis=2, position=position, rows=s1);
  let onlyupdated: storage<int8[1, 2, 8448, 8]> = append(onlycache, knew, axis=2, position=position, rows=s1);
  let kview: storage<int8[1, 2, 0, 8]> = view(kupdated, axis=2, begin=0, end=end);
  let vview: storage<int8[1, 2, 0, 8]> = view(vupdated, axis=2, begin=0, end=end);
  let kf: storage<fp32[1, 2, 0, 8]> = dequantize(kview, scale=0.03125, zero=0);
  let vf: storage<fp32[1, 2, 0, 8]> = dequantize(vview, scale=0.03125, zero=0);
  let q0: storage<fp32[1, 4, 0, 8]> = slice(q, starts=[0, 0, 0, 0], sizes=[-1, 4, -1, -1]);
  let k0: storage<fp32[1, 1, 0, 8]> = slice(kf, starts=[0, 0, 0, 0], sizes=[-1, 1, -1, -1]);
  let v0: storage<fp32[1, 1, 0, 8]> = slice(vf, starts=[0, 0, 0, 0], sizes=[-1, 1, -1, -1]);
  let scores0: storage<fp32[1, 4, 0, 0]> = matmul(q0, k0, adjoint_lhs=false, adjoint_rhs=true);
  let masked0: storage<fp32[1, 4, 0, 0]> = mask(scores0, position=position, begin=0, window=0, scheduled=true);
  let __ynn_op15_scaled: storage<fp32[1, 4, 0, 0]> = mul(masked0, __ynn_op15_beta);
  let __ynn_op15_max: storage<fp32[1, 4, 0, 1]> = reduce_max(__ynn_op15_scaled, axes=[-1], keep_dims=true);
  let __ynn_op15_centered: storage<fp32[1, 4, 0, 0]> = sub(__ynn_op15_scaled, __ynn_op15_max);
  let __ynn_op15_exp: storage<fp32[1, 4, 0, 0]> = exp(__ynn_op15_centered);
  let __ynn_op15_sum: storage<fp32[1, 4, 0, 1]> = reduce_sum(__ynn_op15_exp, axes=[-1], keep_dims=true);
  let __ynn_op15_inverse: storage<fp32[1, 4, 0, 1]> = div(__ynn_op15_one, __ynn_op15_sum);
  let probs0: storage<fp32[1, 4, 0, 0]> = mul(__ynn_op15_exp, __ynn_op15_inverse);
  let context0: storage<fp32[1, 4, 0, 8]> = matmul(probs0, v0, adjoint_lhs=false, adjoint_rhs=false);
  let q1: storage<fp32[1, 4, 0, 8]> = slice(q, starts=[0, 4, 0, 0], sizes=[-1, 4, -1, -1]);
  let k1: storage<fp32[1, 1, 0, 8]> = slice(kf, starts=[0, 1, 0, 0], sizes=[-1, 1, -1, -1]);
  let v1: storage<fp32[1, 1, 0, 8]> = slice(vf, starts=[0, 1, 0, 0], sizes=[-1, 1, -1, -1]);
  let scores1: storage<fp32[1, 4, 0, 0]> = matmul(q1, k1, adjoint_lhs=false, adjoint_rhs=true);
  let masked1: storage<fp32[1, 4, 0, 0]> = mask(scores1, position=position, begin=0, window=0, scheduled=true);
  let __ynn_op22_scaled: storage<fp32[1, 4, 0, 0]> = mul(masked1, __ynn_op15_beta);
  let __ynn_op22_max: storage<fp32[1, 4, 0, 1]> = reduce_max(__ynn_op22_scaled, axes=[-1], keep_dims=true);
  let __ynn_op22_centered: storage<fp32[1, 4, 0, 0]> = sub(__ynn_op22_scaled, __ynn_op22_max);
  let __ynn_op22_exp: storage<fp32[1, 4, 0, 0]> = exp(__ynn_op22_centered);
  let __ynn_op22_sum: storage<fp32[1, 4, 0, 1]> = reduce_sum(__ynn_op22_exp, axes=[-1], keep_dims=true);
  let __ynn_op22_inverse: storage<fp32[1, 4, 0, 1]> = div(__ynn_op15_one, __ynn_op22_sum);
  let probs1: storage<fp32[1, 4, 0, 0]> = mul(__ynn_op22_exp, __ynn_op22_inverse);
  let context1: storage<fp32[1, 4, 0, 8]> = matmul(probs1, v1, adjoint_lhs=false, adjoint_rhs=false);
  let context: storage<fp32[1, 8, 0, 8]> = concat([context0, context1], axis=1);
  let projected: storage<fp32[1, 8, 0, 8]> = matmul(q, weight, adjoint_lhs=false, adjoint_rhs=false);
  let result: fp32[1, 8, s1, 8] = add(context, projected);

  output knew;
  output kupdated;
  output onlyupdated;
  output result;
  output vnew;
  output vupdated;

  metadata {
    order [
      __ynn_op15_beta, __ynn_op15_centered, __ynn_op15_exp, __ynn_op15_inverse, __ynn_op15_max, __ynn_op15_one,
      __ynn_op15_scaled, __ynn_op15_sum, __ynn_op22_centered, __ynn_op22_exp, __ynn_op22_inverse, __ynn_op22_max,
      __ynn_op22_scaled, __ynn_op22_sum, context, context0, context1, fresh, k0, k1, kcache, kf, knew, kupdated, kview,
      masked0, masked1, onlycache, onlyupdated, probs0, probs1, projected, q, q0, q1, result, scores0, scores1, v0, v1, vcache,
      vf, vnew, vsrc, vupdated, vview, weight,
    ];
    name __ynn_op15_beta = "__ynn/op15/beta";
    asset a0 = asset(path="@parameters/948945eecf4a060f48a79e9fadcd501373212c7f5be4fa5ac1ac216f2469c043.bin", bytes=4, sha256="948945eecf4a060f48a79e9fadcd501373212c7f5be4fa5ac1ac216f2469c043");
    name __ynn_op15_centered = "__ynn/op15/centered";
    name __ynn_op15_exp = "__ynn/op15/exp";
    name __ynn_op15_inverse = "__ynn/op15/inverse";
    name __ynn_op15_max = "__ynn/op15/max";
    name __ynn_op15_one = "__ynn/op15/one";
    asset a5 = asset(path="@parameters/e00e5eb9444182f352323374ef4e08ebcb784725fdd4fd612d7730540b3e0c8c.bin", bytes=4, sha256="e00e5eb9444182f352323374ef4e08ebcb784725fdd4fd612d7730540b3e0c8c");
    name __ynn_op15_scaled = "__ynn/op15/scaled";
    name __ynn_op15_sum = "__ynn/op15/sum";
    name __ynn_op22_centered = "__ynn/op22/centered";
    name __ynn_op22_exp = "__ynn/op22/exp";
    name __ynn_op22_inverse = "__ynn/op22/inverse";
    name __ynn_op22_max = "__ynn/op22/max";
    name __ynn_op22_scaled = "__ynn/op22/scaled";
    name __ynn_op22_sum = "__ynn/op22/sum";
    asset a46 = asset(path="@parameters/bd6d006127d2e821be8d68c82f774b26ba70c0d39abaed90fcd33b5ddc6f4314.bin", bytes=256, sha256="bd6d006127d2e821be8d68c82f774b26ba70c0d39abaed90fcd33b5ddc6f4314");
    symbol s1 = 1;
    symbol position = 2;
    resource kcache = resource(name="kcache", axis=2, encoding=encoding(dtype=int8, axis=-1, scales=[0.03125], zero_points=[0]));
    resource onlycache = resource(name="onlycache", axis=2, encoding=encoding(dtype=int8, axis=-1, scales=[0.03125], zero_points=[0]));
    resource vcache = resource(name="vcache", axis=2, encoding=encoding(dtype=int8, axis=-1, scales=[0.03125], zero_points=[0]));
