  fn sliding_window_causal_w512_attention_fp32_h8_kv1_d256_prefill(query: storage<fp32[1, 8, 0, 256]>, keys: storage<fp32[1, 1, 0, 256]>, values: storage<fp32[1, 1, 0, 256]>, query_length: index, key_length: index, query_position: index, key_begin: index) -> (context: storage<fp32[1, 8, 0, 256]>) {
    value centered_scores: storage<fp32[1, 8, 0, 0]>;
    value exp_scores: storage<fp32[1, 8, 0, 0]>;
    value inverse_row_sum: storage<fp32[1, 8, 0, 1]>;
    value row_max: storage<fp32[1, 8, 0, 1]>;
    weight one: storage<fp32[1]> = asset(path="@parameters/e00e5eb9444182f352323374ef4e08ebcb784725fdd4fd612d7730540b3e0c8c.bin", bytes=4, sha256="e00e5eb9444182f352323374ef4e08ebcb784725fdd4fd612d7730540b3e0c8c");
    value row_sum: storage<fp32[1, 8, 0, 1]>;
    value masked_scores: storage<fp32[1, 8, 0, 0]>;
    value probabilities: storage<fp32[1, 8, 0, 0]>;
    value scores: storage<fp32[1, 8, 0, 0]>;
    ResultShape(tensor=query, shape=[1, 8, query_length, 256]);
    ResultShape(tensor=keys, shape=[1, 1, key_length, 256]);
    ResultShape(tensor=values, shape=[1, 1, key_length, 256]);
    @guard(message="symbol 1 lower bound", mode="bounds") require 0 <= query_length;
    @guard(message="symbol 1 upper bound", mode="bounds") require query_length <= 128;
    @guard(message="symbol 2 lower bound", mode="bounds") require 0 <= key_length;
    @guard(message="symbol 2 upper bound", mode="bounds") require key_length <= 32768;
    @guard(message="symbol 3 lower bound", mode="bounds") require 0 <= query_position;
    @guard(message="symbol 3 upper bound", mode="bounds") require query_position <= 32768;
    @guard(message="symbol 4 lower bound", mode="bounds") require 0 <= key_begin;
    @guard(message="symbol 4 upper bound", mode="bounds") require key_begin <= 32768;
    @guard(message="attention live history interval", mode="ordinary") require key_length == add(0, mul(1, query_length), mul(1, query_position), mul(-1, key_begin));
    @guard(message="sliding-window history origin", mode="ordinary") require key_begin == max(0, add(-511, mul(1, query_position)));
    BeginProfileOperation(name="QK", kind="core.matmul", inputs=[query, keys], outputs=[scores], input_names=["query", "keys"]);
    Matmul(lhs=query, rhs=keys, output=scores, adjoint_lhs=false, adjoint_rhs=true);
    EndProfileOperation();
    BeginProfileOperation(name="Mask", kind="ynn.scheduled_mask", inputs=[scores], outputs=[masked_scores], input_names=["scores"]);
    Mask(input=scores, output=masked_scores, position=query_position, begin=key_begin, window=512, scheduled=true);
    EndProfileOperation();
    BeginProfileOperation(name="Softmax", kind="ynn.reduce_max", inputs=[masked_scores], outputs=[row_max], input_names=["masked_scores"]);
    Reduce(operator=max, input=masked_scores, output=row_max, axes=[-1], keep_dims=true);
    EndProfileOperation();
    BeginProfileOperation(name="Softmax", kind="core.sub", inputs=[masked_scores, row_max], outputs=[centered_scores], input_names=["masked_scores", "__ynn/op2/max"]);
    Binary(operator=subtract, lhs=masked_scores, rhs=row_max, output=centered_scores);
    EndProfileOperation();
    BeginProfileOperation(name="Softmax", kind="core.exp", inputs=[centered_scores], outputs=[exp_scores], input_names=["__ynn/op2/centered"]);
    Unary(operator=exp, input=centered_scores, output=exp_scores);
    EndProfileOperation();
    BeginProfileOperation(name="Softmax", kind="ynn.reduce_sum", inputs=[exp_scores], outputs=[row_sum], input_names=["__ynn/op2/exp"]);
    Reduce(operator=sum, input=exp_scores, output=row_sum, axes=[-1], keep_dims=true);
    EndProfileOperation();
    BeginProfileOperation(name="Softmax", kind="core.div", inputs=[one, row_sum], outputs=[inverse_row_sum], input_names=["__ynn/op2/one", "__ynn/op2/sum"]);
    Binary(operator=divide, lhs=one, rhs=row_sum, output=inverse_row_sum);
    EndProfileOperation();
    BeginProfileOperation(name="Softmax", kind="core.mul", inputs=[exp_scores, inverse_row_sum], outputs=[probabilities], input_names=["__ynn/op2/exp", "__ynn/op2/inverse"]);
    Binary(operator=multiply, lhs=exp_scores, rhs=inverse_row_sum, output=probabilities);
    EndProfileOperation();
    BeginProfileOperation(name="PV", kind="core.matmul", inputs=[probabilities, values], outputs=[context], input_names=["probabilities", "values"]);
    Matmul(lhs=probabilities, rhs=values, output=context, adjoint_lhs=false, adjoint_rhs=false);
    EndProfileOperation();
    ResultShape(tensor=context, shape=[1, 8, query_length, 256]);
    return(context);
  }

