    fn "gemma4_cache_only_block_specialized" {
      symbol {binding: {name: "index_3", source: "parameter", value: ""}, id: 3, lower: 1, upper: 32768};
      symbol {binding: {name: "index_1", source: "parameter", value: ""}, id: 1, lower: 1, upper: 128};
      symbol {binding: {name: "position", source: "parameter", value: ""}, id: 2, lower: 0, upper: 32768};
      guard {lhs: known(1), mode: "bounds", reason: "symbol 3 lower bound", relation: "le", rhs: symbol(3)};
      guard {lhs: symbol(3), mode: "bounds", reason: "symbol 3 upper bound", relation: "le", rhs: known(32768)};
      guard {lhs: known(1), mode: "bounds", reason: "symbol 1 lower bound", relation: "le", rhs: symbol(1)};
      guard {lhs: symbol(1), mode: "bounds", reason: "symbol 1 upper bound", relation: "le", rhs: known(128)};
      guard {lhs: known(0), mode: "bounds", reason: "symbol 2 lower bound", relation: "le", rhs: symbol(2)};
      guard {lhs: symbol(2), mode: "bounds", reason: "symbol 2 upper bound", relation: "le", rhs: known(32768)};
      guard {lhs: mul([known(256), max([known(1), symbol(3)])]), mode: "ordinary", reason: "function binding: overlapping resource strides", relation: "le", rhs: mul([known(256), max([known(1), symbol(3)])])};
      guard {lhs: symbol(2), mode: "ordinary", reason: "function binding: resource logical extent exceeds capacity", relation: "le", rhs: symbol(3)};
      guard {lhs: mul([known(512), max([known(1), symbol(3)])]), mode: "ordinary", reason: "function binding: overlapping resource strides", relation: "le", rhs: mul([known(512), max([known(1), symbol(3)])])};
      guard {lhs: symbol(1), mode: "ordinary", reason: "function binding: slice bounds", relation: "le", rhs: symbol(1)};
      guard {lhs: add([known(0), mul([known(1), symbol(1)]), mul([known(1), symbol(2)])]), mode: "ordinary", reason: "function binding: append capacity", relation: "le", rhs: symbol(3)};
      guard {lhs: max([known(0), add([known(-511), mul([known(1), symbol(2)])])]), mode: "ordinary", reason: "function binding: view interval", relation: "le", rhs: add([known(0), mul([known(1), symbol(1)]), mul([known(1), symbol(2)])])};
