(decl pure decode_eligible () Flag)
(extern constructor decode_eligible decode_eligible)
(decl decode_reshape (Val) Val)
(extern constructor decode_reshape decode_reshape)
(decl decode_dot (Val Val) Val)
(extern constructor decode_dot decode_dot)
(decl decode_result (Val) Flag)
(extern constructor decode_result decode_result)
(decl keep_node () Flag)
(extern constructor keep_node keep_node)
(decl decode_rows () Flag)
(rule 1 (decode_rows) (if-let 1 (decode_eligible))
  (let ((row Val (decode_reshape (input 0)))
        (dot Val (decode_dot row (input 1))))
    (decode_result dot)))
(rule 0 (decode_rows) (keep_node))
