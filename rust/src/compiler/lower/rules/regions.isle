(type NodeId (primitive usize))
(type Flag (primitive u8))
(type Region (enum (Causal (conv NodeId) (expand NodeId) (concat NodeId) (state NodeId))))
(decl depthwise (NodeId) NodeId)
(extern extractor depthwise depthwise)
(decl expanded (NodeId) NodeId)
(extern extractor expanded expanded)
(decl history_concat () NodeId)
(extern extractor history_concat history_concat)
(decl pure partial history_state (NodeId) NodeId)
(extern constructor history_state history_state)
(decl pure region_legal (NodeId NodeId NodeId NodeId) Flag)
(extern constructor region_legal region_legal)
(decl pure partial causal_region (NodeId) Region)
(rule (causal_region (and conv (depthwise (and expand (expanded (and cat (history_concat)))))))
  (if-let state (history_state cat))
  (if-let 1 (region_legal conv expand cat state))
  (Region.Causal conv expand cat state))
