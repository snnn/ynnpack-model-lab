;; Value handles belong to one construction context, never to the public ABI.
(type Val (primitive usize))
(type Flag (primitive u8))
(type Int (primitive i64))
(type Op (primitive Op))
(type QuantInput (enum (Input (zero Val) (scale Val) (codes Val))))
(extern const $Mul Op)
(extern const $Sub Op)
(extern const $Add Op)
(extern const $Div Op)
(extern const $Exp Op)
(extern const $Neg Op)
(extern const $Matmul Op)
(extern const $ReduceMax Op)
(extern const $ReduceSum Op)
(extern const $ReduceMinMax Op)
(decl pure input (Int) Val)
(extern constructor input input)
(decl  scalar (Int) Val)
(extern constructor scalar scalar)
(decl  unary (Op Val) Val)
(extern constructor unary unary)
(decl  binary (Op Val Val) Val)
(extern constructor binary binary)
(decl  reduction (Op Val) Val)
(extern constructor reduction reduction)
(decl  finish (Val) Flag)
(extern constructor finish finish)
(decl  output_mul (Val Val) Flag)
(extern constructor output_mul output_mul)
(decl pure weight_only () Flag)
(extern constructor weight_only weight_only)
(decl pure blockwise () Flag)
(extern constructor blockwise blockwise)
(decl pure float_linear () Flag)
(extern constructor float_linear float_linear)
(decl pure vector_input () Flag)
(extern constructor vector_input vector_input)
(decl pure has_bias () Flag)
(extern constructor has_bias has_bias)
(decl pure static_input () Flag)
(extern constructor static_input static_input)
(decl pure quant_output () Flag)
(extern constructor quant_output quant_output)
(decl  native_weight_only () Flag)
(extern constructor native_weight_only native_weight_only)
(decl  native_blockwise () Flag)
(extern constructor native_blockwise native_blockwise)
(decl  weight_transpose (Val) Val)
(extern constructor weight_transpose weight_transpose)
(decl  matrix_input (Val) Val)
(extern constructor matrix_input matrix_input)
(decl  vector_output (Val) Flag)
(extern constructor vector_output vector_output)
(decl  weight_scale () Val)
(extern constructor weight_scale weight_scale)
(decl  zero () Val)
(extern constructor zero zero)
(decl  static_scale () Val)
(extern constructor static_scale static_scale)
(decl  fresh_zero () Val)
(extern constructor fresh_zero fresh_zero)
(decl  fresh_scale () Val)
(extern constructor fresh_scale fresh_scale)
(decl  dynamic_parameters (Val Val Val) Flag)
(extern constructor dynamic_parameters dynamic_parameters)
(decl  quantize_input (Val Val Val) Val)
(extern constructor quantize_input quantize_input)
(decl  accumulator_scale (Val Val) Val)
(extern constructor accumulator_scale accumulator_scale)
(decl  weight_sum (Val) Val)
(extern constructor weight_sum weight_sum)
(decl  correction (Val Val) Val)
(extern constructor correction correction)
(decl  dot (Val Val) Val)
(extern constructor dot dot)
(decl  biased_dot (Val Val Val) Val)
(extern constructor biased_dot biased_dot)
(decl  dequantize (Val Val) Val)
(extern constructor dequantize dequantize)
(decl  quantize_output (Val Val) Flag)
(extern constructor quantize_output quantize_output)
(decl pure beta_is_one () Flag)
(extern constructor beta_is_one beta_is_one)
(decl  beta () Val)
(extern constructor beta beta)
