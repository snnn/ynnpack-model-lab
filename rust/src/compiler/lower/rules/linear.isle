;; Priorities preserve the established native > grouped > float > hybrid choice.
(decl linear () Flag)
(rule 40 (linear) (if-let 1 (weight_only)) (native_weight_only))
(rule 30 (linear) (if-let 1 (blockwise)) (native_blockwise))
(rule 20 (linear) (if-let 1 (float_linear))
  (let ((w Val (weight_transpose (input 1)))
        (x Val (fc_matrix (input 0)))
        (product Val (binary $Matmul x w))
        (biased Val (fc_bias product)))
    (fc_result biased)))
(rule 0 (linear)
  (let ((w Val (weight_transpose (input 1)))
        (ws Val (weight_scale))
        (z Val (zero))
        (q QuantInput (fc_input z (input 0))))
    (fc_quantized w ws z q)))
(decl fc_matrix (Val) Val)
(rule 1 (fc_matrix x) (if-let 1 (vector_input)) (matrix_input x))
(rule 0 (fc_matrix x) x)
(decl fc_bias (Val) Val)
(rule 1 (fc_bias x) (if-let 1 (has_bias)) (binary $Add x (input 2)))
(rule 0 (fc_bias x) x)
(decl fc_result (Val) Flag)
(rule 1 (fc_result x) (if-let 1 (vector_input)) (vector_output x))
(rule 0 (fc_result x) (finish x))
(decl fc_input (Val Val) QuantInput)
(rule 1 (fc_input z x) (if-let 1 (static_input))
  (QuantInput.Input z (static_scale) x))
(rule 0 (fc_input z x)
  (let ((mm Val (reduction $ReduceMinMax x))
        (az Val (fresh_zero))
        (scale Val (fresh_scale))
        (_ Flag (dynamic_parameters mm az scale))
        (codes Val (quantize_input x az scale)))
    (QuantInput.Input az scale codes)))
(decl fc_quantized (Val Val Val QuantInput) Flag)
(rule (fc_quantized w ws z (QuantInput.Input az scale codes))
  (let ((s Val (accumulator_scale scale ws))
        (accum Val (fc_accumulator codes w az))
        (f Val (dequantize accum s)))
    (fc_output f z)))
(decl fc_accumulator (Val Val Val) Val)
(rule 1 (fc_accumulator x w az) (if-let 1 (static_input)) (dot x w))
(rule 0 (fc_accumulator x w az)
  (let ((sum Val (weight_sum w))
        (c Val (correction az sum))
        (bias Val (unary $Neg c)))
    (biased_dot x w bias)))
(decl fc_output (Val Val) Flag)
(rule 1 (fc_output f z) (if-let 1 (quant_output)) (quantize_output f z))
(rule 0 (fc_output f z) (finish f))

;; The same softmax rules serve standalone operations and attention.
(decl softmax (Val) Flag)
(rule (softmax source)
  (let ((x Val (softmax_input source))
        (max Val (reduction $ReduceMax x))
        (center Val (binary $Sub x max))
        (exp Val (unary $Exp center))
        (sum Val (reduction $ReduceSum exp))
        (one Val (scalar 1))
        (inv Val (binary $Div one sum)))
    (output_mul exp inv)))
(decl softmax_input (Val) Val)
(rule 1 (softmax_input x) (if-let 1 (beta_is_one)) x)
(rule 0 (softmax_input x) (binary $Mul x (beta)))
