;; Numerical permissions and geometry are facts; construction order is explicit.
(decl attention () Flag)
(rule 30 (attention) (if-let 0 (attention_eligible)) (keep_node))
(rule 20 (attention) (if-let 0 (head_group)) (slice_all (attention_scale)))
(rule 0 (attention)
  (let ((q Val (prepare_query (input 0)))
        (k Val (prepare_key (input 1)))
        (scale Val (attention_scale))
        (q Val (binary $Mul q scale))
        (mask Val (prepare_mask))
        (scores Val (attention_scores q k))
        (scores Val (canonical_scores scores))
        (p Val (mask_probabilities scores mask))
        (p Val (group_probabilities p))
        (v Val (attention_value))
        (context Val (attention_context p v))
        (context Val (canonical_context context)))
    (finish context)))
(decl prepare_query (Val) Val)
(rule 1 (prepare_query x) (if-let 1 (multiple_heads)) (reshape_heads x))
(rule 0 (prepare_query x) x)
(decl prepare_key (Val) Val)
(rule 1 (prepare_key x) (if-let 1 (multiple_heads)) (if-let 0 (small_query)) (expand_attention x))
(rule 0 (prepare_key x) x)
(decl reshape_heads (Val) Val)
(rule (reshape_heads x) (fold_head_rows (split_heads x)))
(decl fold_head_rows (Val) Val)
(rule 1 (fold_head_rows x) (if-let 1 (small_query)) (fuse_group_rows x))
(rule 0 (fold_head_rows x) x)
(decl canonical_heads (Val) Val)
(rule (canonical_heads x) (fuse_heads (unfold_head_rows x)))
(decl unfold_head_rows (Val) Val)
(rule 1 (unfold_head_rows x) (if-let 1 (small_query)) (split_head_rows x))
(rule 0 (unfold_head_rows x) x)
(decl prepare_mask () Val)
(rule 2 (prepare_mask) (if-let 0 (has_mask)) 0)
(rule 1 (prepare_mask) (if-let 1 (grouped_scores)) (group_mask (input 3)))
(rule 0 (prepare_mask) (input 3))
(decl group_mask (Val) Val)
(rule 2 (group_mask x) (if-let 1 (mask_expand)) (expand_attention x))
(rule 1 (group_mask x) (if-let 1 (mask_split)) (split_mask x))
(rule 0 (group_mask x) x)
(decl attention_scores (Val Val) Val)
(rule 1 (attention_scores q k) (if-let 1 (small_query)) (transpose_attention (attention_dot k q 1)))
(rule 0 (attention_scores q k) (attention_dot q k 1))
(decl canonical_scores (Val) Val)
(rule 1 (canonical_scores x) (if-let 1 (multiple_heads)) (if-let 0 (grouped_scores)) (canonical_heads x))
(rule 0 (canonical_scores x) x)
(decl group_probabilities (Val) Val)
(rule 1 (group_probabilities x) (if-let 1 (multiple_heads)) (if-let 0 (grouped_scores)) (reshape_heads x))
(rule 0 (group_probabilities x) x)
(decl mask_probabilities (Val Val) Val)
(rule (mask_probabilities x mask) (probabilities (causal_scores (explicit_mask x mask))))
(decl explicit_mask (Val Val) Val)
(rule 2 (explicit_mask x mask) (if-let 0 (has_mask)) x)
(rule 1 (explicit_mask x mask) (if-let 1 (boolean_mask)) (select_mask mask x (negative_infinity)))
(rule 0 (explicit_mask x mask) (binary $Add x mask))
(decl causal_scores (Val) Val)
(rule 1 (causal_scores x) (if-let 1 (causal)) (causal_mask x))
(rule 0 (causal_scores x) x)
(decl attention_context (Val Val) Val)
(rule 1 (attention_context p v) (if-let 1 (small_query))
  (transpose_attention (attention_dot (small_value v) p 1)))
(rule 0 (attention_context p v) (attention_dot p (expand_value v) (value_transposed)))
(decl small_value (Val) Val)
(rule 1 (small_value v) (if-let 0 (value_transposed)) (transpose_attention v))
(rule 0 (small_value v) v)
(decl expand_value (Val) Val)
(rule 1 (expand_value v) (if-let 1 (multiple_heads)) (expand_attention v))
(rule 0 (expand_value v) v)
(decl canonical_context (Val) Val)
(rule 1 (canonical_context x) (if-let 1 (multiple_heads)) (canonical_heads x))
(rule 0 (canonical_context x) x)
;; Rust enumerates contiguous head runs. This rule owns every run's computation.
(decl attention_slice (Int Int Int Val) Val)
(rule (attention_slice first count kv scale)
  (let ((q Val (slice_input 0 first count))
        (k Val (slice_input 1 kv 1))
        (v Val (slice_input 2 kv 1))
        (dot Val (attention_dot q k 1))
        (scores Val (binary $Mul dot scale))
        (mask Val (slice_mask first count))
        (p Val (mask_probabilities scores mask)))
    (attention_dot p v 0)))
(decl slice_mask (Int Int) Val)
(rule 2 (slice_mask first count) (if-let 0 (has_mask)) 0)
(rule 1 (slice_mask first count) (if-let 1 (mask_needs_slice)) (head_mask first count))
(rule 0 (slice_mask first count) (input 3))
(decl pure attention_eligible () Flag)
(extern constructor attention_eligible attention_eligible)
(decl pure head_group () Int)
(extern constructor head_group head_group)
(decl pure multiple_heads () Flag)
(extern constructor multiple_heads multiple_heads)
(decl pure small_query () Flag)
(extern constructor small_query small_query)
(decl pure grouped_scores () Flag)
(extern constructor grouped_scores grouped_scores)
(decl pure has_mask () Flag)
(extern constructor has_mask has_mask)
(decl pure boolean_mask () Flag)
(extern constructor boolean_mask boolean_mask)
(decl pure causal () Flag)
(extern constructor causal causal)
(decl pure mask_expand () Flag)
(extern constructor mask_expand mask_expand)
(decl pure mask_split () Flag)
(extern constructor mask_split mask_split)
(decl pure value_transposed () Flag)
(extern constructor value_transposed value_transposed)
(decl pure mask_needs_slice () Flag)
(extern constructor mask_needs_slice mask_needs_slice)
(decl  attention_scale () Val)
(extern constructor attention_scale attention_scale)
(decl  split_heads (Val) Val)
(extern constructor split_heads split_heads)
(decl  fuse_group_rows (Val) Val)
(extern constructor fuse_group_rows fuse_group_rows)
(decl  split_head_rows (Val) Val)
(extern constructor split_head_rows split_head_rows)
(decl  fuse_heads (Val) Val)
(extern constructor fuse_heads fuse_heads)
(decl  transpose_attention (Val) Val)
(extern constructor transpose_attention transpose_attention)
(decl  expand_attention (Val) Val)
(extern constructor expand_attention expand_attention)
(decl  attention_dot (Val Val Flag) Val)
(extern constructor attention_dot attention_dot)
(decl  split_mask (Val) Val)
(extern constructor split_mask split_mask)
(decl  attention_value () Val)
(extern constructor attention_value attention_value)
(decl  negative_infinity () Val)
(extern constructor negative_infinity negative_infinity)
(decl  select_mask (Val Val Val) Val)
(extern constructor select_mask select_mask)
(decl  causal_mask (Val) Val)
(extern constructor causal_mask causal_mask)
(decl  probabilities (Val) Val)
(extern constructor probabilities probabilities)
(decl  slice_all (Val) Flag)
(extern constructor slice_all slice_all)
(decl  slice_input (Int Int Int) Val)
(extern constructor slice_input slice_input)
(decl  head_mask (Int Int) Val)
(extern constructor head_mask head_mask)
