+GET_PROPERTY(LAB_DOT_TARGETS DIRECTORY PROPERTY BUILDSYSTEM_TARGETS)
+FOREACH(LAB_TARGET ${LAB_DOT_TARGETS})
+  IF(NOT LAB_TARGET STREQUAL "ynnpack_dot_generated_headers")
